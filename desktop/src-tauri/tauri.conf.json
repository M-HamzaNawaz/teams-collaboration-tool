{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Confide",
  "version": "0.1.0",
  "identifier": "ai.algotix.confide",
  "build": {
    "frontendDist": "https://teams-collaboration-tool-bwfb.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "Confide",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Confide — team collaboration",
    "longDescription": "Team and client chat with built-in contact-info protection, moderation, and a tamper-proof audit log."
  }
}
