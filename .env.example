# Confide — environment template
# Copy to .env.local and fill in. Never commit .env.local.
#
# Local values come from `npm run db:start`, which prints the API URL and keys.

# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Supabase — server only
#
# SERVICE_ROLE_KEY bypasses Row Level Security. It is the key that lets the API
# layer write messages that clients cannot. It must never reach the browser:
# src/lib/supabase/service-client.ts is guarded by `server-only` so importing it
# from a client component fails the build (M0-07).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=""

# Direct Postgres connection, used by db tests and the seed script.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ---------------------------------------------------------------------------
# Email (M4-04 invitations, M6-03 admin alerts)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Confide <noreply@example.com>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
